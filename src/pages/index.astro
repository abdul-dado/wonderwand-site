---
// Root entry: Arabic is the default for everyone (English is one tap away via
// the header toggle). Prerendered to a tiny static file with a <meta> refresh
// for no-JS visitors.
const fallback = '/ar/';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <link rel="canonical" href="https://wonderwand.org/ar/" />
    <title>Wonder Wand</title>
    <script is:inline>
      location.replace('/ar/' + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>Redirecting… <a href="/ar/">Wonder Wand</a></p>
  </body>
</html>
