---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { useTranslations, localizedPath, locales, type Lang } from '@/i18n';
import { tx } from '@/data/site';
import { loadContent } from '@/lib/content';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const title = t('success.title');
const content = await loadContent();
---

<BaseLayout lang={lang} path="/success/" title={`${title} — Wonder Wand`} noindex content={content}>
  <Header lang={lang} />
  <main class="mx-auto max-w-xl px-4 py-20 text-center">
    <div class="text-5xl" aria-hidden="true">🎉</div>
    <h1 class="mt-4 text-2xl font-extrabold text-ink sm:text-3xl">{title}</h1>
    <p class="mt-4 text-lg text-ink/80">{t('success.pending')}</p>

    <p
      id="ref-badge"
      class="mt-6 hidden rounded-2xl bg-grape-50 px-6 py-3 font-display text-lg font-bold text-grape-700"
    >
      {t('success.ref')}: <span id="ref-value" class="tracking-wider"></span>
    </p>

    <div class="mt-6 rounded-2xl border border-grape-100 bg-white p-6 text-start text-ink/80">
      {tx(content.registration.paymentInstructions, lang)}
    </div>

    <a
      href={localizedPath(lang, '/')}
      class="mt-8 inline-block rounded-full bg-grape-600 px-6 py-3 font-bold text-cream hover:bg-grape-700"
    >
      {t('success.back')}
    </a>
  </main>
  <Footer lang={lang} content={content} />

  <script is:inline>
    (function () {
      var ref = new URLSearchParams(location.search).get('ref');
      if (!ref) return;
      var v = document.getElementById('ref-value');
      var badge = document.getElementById('ref-badge');
      if (v && badge) {
        v.textContent = ref;
        badge.classList.remove('hidden');
      }
    })();
  </script>
</BaseLayout>
