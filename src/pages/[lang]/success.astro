---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { useTranslations, localizedPath, locales, type Lang } from '@/i18n';
import { tx, waHref } from '@/data/site';
import { loadContent } from '@/lib/content';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const title = t('success.title');
const content = await loadContent();
const reg = content.registration;
// The pre-filled WhatsApp message; the client swaps {ref} for the real reference.
const waTemplate =
  lang === 'ar'
    ? 'مرحباً، هذا إيصال الدفع لحجز رقم {ref}.'
    : 'Hi, here is the payment receipt for booking {ref}.';
const waBase = waHref(content.social.whatsapp);
---

<BaseLayout lang={lang} path="/success/" title={`${title} — Wonder Wand`} noindex content={content}>
  <Header lang={lang} />
  <main class="mx-auto max-w-xl px-4 py-20 text-center">
    <div class="text-5xl" aria-hidden="true">🎉</div>
    <h1 class="mt-4 text-2xl font-extrabold text-ink sm:text-3xl">{title}</h1>
    <p class="mt-4 text-lg text-ink/80">{t('success.pending')}</p>

    <p
      id="ref-badge"
      class="mt-6 hidden rounded-2xl bg-grape-50 px-6 py-3 font-display text-lg font-bold text-grape-700"
    >
      {t('success.ref')}: <span id="ref-value" class="tracking-wider"></span>
    </p>

    <div class="mt-6 rounded-2xl border border-grape-100 bg-white p-6 text-start text-ink/80">
      <p>{tx(reg.paymentInstructions, lang)}</p>
      {
        reg.cliqAlias && (
          <p class="mt-4 rounded-xl bg-grape-50 px-4 py-3 text-center font-display text-lg font-bold text-grape-700">
            CliQ: <span dir="ltr">{reg.cliqAlias}</span>
          </p>
        )
      }
    </div>

    {
      waBase && (
        <a
          id="wa-btn"
          href={waBase}
          target="_blank"
          rel="noopener"
          data-base={waBase}
          data-template={waTemplate}
          class="mt-6 inline-block rounded-full bg-[#25d366] px-7 py-3.5 text-base font-extrabold text-white shadow-sm hover:brightness-95"
        >
          💬 {t('success.whatsapp')}
        </a>
      )
    }

    <div>
      <a
        href={localizedPath(lang, '/')}
        class="mt-6 inline-block rounded-full border border-grape-200 px-6 py-3 font-bold text-grape-700 hover:bg-grape-50"
      >
        {t('success.back')}
      </a>
    </div>
  </main>
  <Footer lang={lang} content={content} />

  <script is:inline>
    (function () {
      var ref = new URLSearchParams(location.search).get('ref');
      if (!ref) return;
      var v = document.getElementById('ref-value');
      var badge = document.getElementById('ref-badge');
      if (v && badge) {
        v.textContent = ref;
        badge.classList.remove('hidden');
      }
      var wa = document.getElementById('wa-btn');
      if (wa) {
        var text = (wa.dataset.template || '').replace('{ref}', ref);
        var base = wa.dataset.base || '';
        wa.href = base + (base.indexOf('?') >= 0 ? '&' : '?') + 'text=' + encodeURIComponent(text);
      }
    })();
  </script>
</BaseLayout>
