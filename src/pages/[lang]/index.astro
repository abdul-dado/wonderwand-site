---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnnouncementBar from '@/components/AnnouncementBar.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import About from '@/components/About.astro';
import EventDetails from '@/components/EventDetails.astro';
import Activities from '@/components/Activities.astro';
import BookingForm from '@/components/BookingForm.astro';
import Faq from '@/components/Faq.astro';
import Footer from '@/components/Footer.astro';
import StickyCta from '@/components/StickyCta.astro';
import { locales, type Lang } from '@/i18n';
import { tx, childPrice } from '@/data/site';
import { loadContent } from '@/lib/content';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const content = await loadContent();
const e = content.event;
const reg = content.registration;

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: tx(content.seo.title, lang),
  startDate: e.startsAt,
  ...(e.endsAt ? { endDate: e.endsAt } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  description: tx(content.seo.description, lang),
  location: {
    '@type': 'Place',
    name: tx(e.venueName, lang),
    address: tx(e.address, lang),
  },
  organizer: {
    '@type': 'Organization',
    name: content.brandName,
    url: 'https://wonderwand.org',
  },
  ...(reg.status === 'open'
    ? {
        offers: {
          '@type': 'Offer',
          price: childPrice(reg.pricing),
          priceCurrency: reg.pricing.currency,
          availability: 'https://schema.org/InStock',
          url: 'https://wonderwand.org/' + lang + '/#book',
        },
      }
    : {}),
  image: [new URL(content.seo.ogImage, Astro.site).href],
};
---

<BaseLayout lang={lang} path="/" content={content}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(eventLd)}
    is:inline
  />

  <AnnouncementBar lang={lang} content={content} />
  <Header lang={lang} />
  <main>
    <Hero lang={lang} content={content} />
    <About lang={lang} content={content} />
    <EventDetails lang={lang} content={content} />
    <Activities lang={lang} content={content} />
    <BookingForm lang={lang} content={content} />
    <Faq lang={lang} content={content} />
  </main>
  <Footer lang={lang} content={content} />
  <StickyCta lang={lang} />
</BaseLayout>
