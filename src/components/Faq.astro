---
import { type Lang } from '@/i18n';
import { site, tx } from '@/data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16">
  <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">
    {lang === 'ar' ? 'أسئلة شائعة' : 'FAQ'}
  </h2>
  <div class="mt-6 divide-y divide-grape-100 rounded-2xl border border-grape-100 bg-white">
    {
      site.faq.map((f) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between font-display font-bold text-ink">
            {tx(f.q, lang)}
            <span class="text-grape-400 transition group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="mt-2 text-ink/75">{tx(f.a, lang)}</p>
        </details>
      ))
    }
  </div>
</section>
