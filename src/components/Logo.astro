---
import WandMark from './WandMark.astro';

interface Props {
  /** 'ink' for light backgrounds, 'cream' for dark backgrounds. */
  tone?: 'ink' | 'cream';
  class?: string;
}
const { tone = 'ink', class: className = '' } = Astro.props;
const textColor = tone === 'cream' ? 'text-cream' : 'text-grape-700';
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <WandMark size={30} class="shrink-0" sparkles={false} />
  <span class:list={['font-display text-lg font-extrabold leading-none', textColor]}>
    Wonder Wand
  </span>
</span>
