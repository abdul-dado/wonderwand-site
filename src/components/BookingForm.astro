---
import { useTranslations, type Lang } from '@/i18n';
import { site, tx } from '@/data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const reg = site.registration;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const closed = reg.status !== 'open';
const closedMsg =
  reg.status === 'sold_out' ? t('tickets.soldOut') : t('tickets.closed');
---

<section id="book" class="scroll-mt-24 bg-grape-50 py-16">
  <div class="mx-auto max-w-xl px-4">
    <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">{t('form.title')}</h2>
    <p class="mt-2 text-ink/70">{tx(reg.paymentInstructions, lang)}</p>

    {
      closed ? (
        <div class="mt-6 rounded-2xl border border-grape-200 bg-white p-6 text-center font-display text-lg font-bold text-grape-700">
          {closedMsg}
        </div>
      ) : (
        <form
          id="booking-form"
          method="POST"
          action="/api/book"
          data-tbd-label={t('event.tbd')}
          data-submitting-label={t('form.submitting')}
          data-no-seats-label={
            lang === 'ar'
              ? 'اختر عدد التذاكر أولًا.'
              : 'Please choose at least one ticket.'
          }
          data-error-label={
            lang === 'ar'
              ? 'حدث خطأ، حاول مرة أخرى.'
              : 'Something went wrong. Please try again.'
          }
          class="mt-6 space-y-4 rounded-2xl border border-grape-100 bg-white p-6 shadow-sm"
        >
          <input type="hidden" name="lang" value={lang} />
          {/* honeypot */}
          <input
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            aria-hidden="true"
          />

          <div>
            <label class="block text-sm font-semibold text-ink" for="parentName">
              {t('form.parentName')} <span class="text-bubblegum">*</span>
            </label>
            <input
              id="parentName"
              name="parentName"
              required
              autocomplete="name"
              class="mt-1 w-full rounded-xl border border-grape-200 px-3 py-2.5 outline-none focus:border-grape-500"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-sm font-semibold text-ink" for="phone">
                {t('form.phone')} <span class="text-bubblegum">*</span>
              </label>
              <input
                id="phone"
                name="phone"
                type="tel"
                required
                inputmode="tel"
                autocomplete="tel"
                class="mt-1 w-full rounded-xl border border-grape-200 px-3 py-2.5 outline-none focus:border-grape-500"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-ink" for="city">
                {t('form.city')}
              </label>
              <input
                id="city"
                name="city"
                autocomplete="address-level2"
                class="mt-1 w-full rounded-xl border border-grape-200 px-3 py-2.5 outline-none focus:border-grape-500"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-ink" for="email">
              {t('form.email')} <span class="text-bubblegum">*</span>
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="mt-1 w-full rounded-xl border border-grape-200 px-3 py-2.5 outline-none focus:border-grape-500"
            />
          </div>

          <fieldset class="rounded-xl border border-grape-100 p-4">
            <legend class="px-1 text-sm font-semibold text-ink">
              {t('form.ticketType')}
            </legend>
            <div class="space-y-3">
              {reg.ticketTypes.map((tt) => (
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="font-semibold text-ink">{tx(tt.name, lang)}</p>
                    <p class="text-xs text-ink/60">
                      {tt.soldOut ? t('tickets.soldOut') : tx(tt.note, lang)}
                    </p>
                  </div>
                  <input
                    type="number"
                    name={`qty_${tt.id}`}
                    min="0"
                    max={tt.perOrderLimit}
                    value="0"
                    disabled={tt.soldOut}
                    data-price={tt.price}
                    class="qty w-16 rounded-xl border border-grape-200 px-2 py-2 text-center outline-none focus:border-grape-500 disabled:opacity-40"
                  />
                </div>
              ))}
            </div>
            <p class="mt-3 text-sm font-semibold text-grape-700">
              {t('form.total')}: <span id="total">—</span>
            </p>
          </fieldset>

          <div>
            <label class="block text-sm font-semibold text-ink" for="kidsAges">
              {t('form.kidsAges')}
            </label>
            <input
              id="kidsAges"
              name="kidsAges"
              placeholder={t('form.kidsAgesHint')}
              class="mt-1 w-full rounded-xl border border-grape-200 px-3 py-2.5 outline-none focus:border-grape-500"
            />
          </div>

          <div>
            <label class="block text-sm font-semibold text-ink" for="hearAbout">
              {t('form.hearAbout')}
            </label>
            <input
              id="hearAbout"
              name="hearAbout"
              class="mt-1 w-full rounded-xl border border-grape-200 px-3 py-2.5 outline-none focus:border-grape-500"
            />
          </div>

          <label class="flex items-start gap-2 text-sm text-ink/80">
            <input type="checkbox" name="consent" required class="mt-1" />
            <span>{t('form.consent')}</span>
          </label>

          {turnstileKey && (
            <div
              class="cf-turnstile"
              data-sitekey={turnstileKey}
              data-theme="light"
            />
          )}

          <button
            type="submit"
            class="w-full rounded-full bg-grape-600 px-6 py-3.5 text-base font-extrabold text-cream shadow-sm transition hover:bg-grape-700 disabled:opacity-60"
          >
            {t('form.submit')}
          </button>

          <p id="form-error" class="hidden text-sm font-semibold text-bubblegum"></p>
        </form>
      )
    }
  </div>
</section>

{
  turnstileKey && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  if (form) {
    const totalEl = document.getElementById('total')!;
    const errEl = document.getElementById('form-error')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submitBtn.textContent;
    const tbd = form.dataset.tbdLabel || '';
    const qtyInputs = [...form.querySelectorAll<HTMLInputElement>('.qty')];

    const recalc = () => {
      let total = 0;
      let count = 0;
      for (const input of qtyInputs) {
        const n = Math.max(0, Number(input.value) || 0);
        count += n;
        total += n * Number(input.dataset.price || 0);
      }
      totalEl.textContent =
        count === 0 ? '—' : total === 0 ? tbd || '—' : `${total} JOD`;
    };
    qtyInputs.forEach((i) => i.addEventListener('input', recalc));
    recalc();

    form.addEventListener('submit', async (event) => {
      const anySeats = qtyInputs.some((i) => (Number(i.value) || 0) > 0);
      if (!anySeats) {
        event.preventDefault();
        errEl.textContent = form.dataset.noSeatsLabel || '';
        errEl.classList.remove('hidden');
        return;
      }
      // Progressive enhancement: submit via fetch, then go to the localized
      // success page with the booking reference.
      event.preventDefault();
      errEl.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.submittingLabel || submitLabel;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          ref?: string;
          error?: string;
        };
        if (res.ok && data.ok) {
          const lang = (form.querySelector('[name="lang"]') as HTMLInputElement).value;
          const url = new URL(`/${lang}/success/`, location.origin);
          if (data.ref) url.searchParams.set('ref', data.ref);
          location.href = url.href;
          return;
        }
        throw new Error(data.error || 'error');
      } catch {
        errEl.textContent = form.dataset.errorLabel || 'Something went wrong. Please try again.';
        errEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    });
  }
</script>
