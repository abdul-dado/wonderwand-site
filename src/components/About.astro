---
import { type Lang } from '@/i18n';
import { site, tx } from '@/data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section id="about" class="mx-auto max-w-4xl scroll-mt-24 px-4 py-16">
  <p class="font-display text-sm font-bold uppercase tracking-wide text-grape-500">
    {tx(site.about.hosts, lang)}
  </p>
  <h2 class="mt-2 text-2xl font-extrabold text-ink sm:text-3xl">
    {tx(site.about.title, lang)}
  </h2>
  <p class="mt-4 text-lg leading-relaxed text-ink/80">
    {tx(site.about.body, lang)}
  </p>
  <p class="mt-6 font-display text-xl font-bold text-grape-600">
    {tx(site.tagline, lang)}
  </p>
</section>
