---
/**
 * Wonder Wand mark — a pastel star wand, recreated as inline SVG so it stays
 * crisp at any size (header logo, favicon, share images).
 */
interface Props {
  size?: number;
  class?: string;
  /** Show the swirl + sparkles around the star. */
  sparkles?: boolean;
}
const { size = 28, class: className = '', sparkles = true } = Astro.props;
const uid = 'wand-' + Math.random().toString(36).slice(2, 8);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  class={className}
  role="img"
  aria-label="Wonder Wand"
>
  <defs>
    <linearGradient id={`${uid}-star`} x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#fef1c7"></stop>
      <stop offset="0.4" stop-color="#ffd6ea"></stop>
      <stop offset="0.72" stop-color="#e6d2fb"></stop>
      <stop offset="1" stop-color="#cdb8f5"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-handle`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f7cbe7"></stop>
      <stop offset="1" stop-color="#c6b2ef"></stop>
    </linearGradient>
  </defs>

  {
    sparkles && (
      <>
        <path
          d="M11 36c3-7 9-11 17-11s15 4 18 10"
          stroke="#bfe3f5"
          stroke-width="2.4"
          stroke-linecap="round"
          fill="none"
        />
        <g fill="#ffd24b">
          <path d="M50 12l1.1 2.5 2.5 1.1-2.5 1.1L50 20.3l-1.1-2.5L46.4 16.7l2.5-1.1z" />
          <path d="M13 20l.9 2 2 .9-2 .9-.9 2-.9-2-2-.9 2-.9z" />
        </g>
      </>
    )
  }

  {/* handle — almost upright, a hair of lean for character */}
  <path
    d="M33 25 L29.5 57"
    stroke="#48258f"
    stroke-width="8"
    stroke-linecap="round"
  ></path>
  <path
    d="M33 25 L29.5 57"
    stroke={`url(#${uid}-handle)`}
    stroke-width="4.4"
    stroke-linecap="round"
  ></path>

  {/* star */}
  <path
    d="M32 3 L36 14.5 L48.17 14.75 L38.47 22.1 L41.99 33.75 L32 26.8 L22.01 33.75 L25.53 22.1 L15.83 14.75 L28 14.5 Z"
    fill={`url(#${uid}-star)`}
    stroke="#48258f"
    stroke-width="2.8"
    stroke-linejoin="round"
  ></path>
  <circle cx="27" cy="14" r="2.1" fill="#ffffff" opacity="0.75"></circle>
</svg>
