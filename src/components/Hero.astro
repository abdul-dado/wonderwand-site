---
import { useTranslations, type Lang } from '@/i18n';
import { site, tx } from '@/data/site';
import Countdown from './Countdown.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-grape-900 text-cream">
  <div
    class="pointer-events-none absolute inset-0 opacity-70"
    style="background:
      radial-gradient(60% 50% at 15% 0%, rgba(122,69,236,.55), transparent 60%),
      radial-gradient(50% 50% at 90% 20%, rgba(56,189,248,.35), transparent 60%),
      radial-gradient(40% 40% at 70% 100%, rgba(255,111,181,.30), transparent 60%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-4xl px-4 py-16 text-center sm:py-24">
    <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-semibold">
      <span aria-hidden="true">🎉</span>{tx(site.hero.kicker, lang)}
    </p>

    <h1 class="text-3xl font-extrabold sm:text-5xl">
      {tx(site.hero.title, lang)}
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-base text-cream/85 sm:text-lg">
      {tx(site.hero.subtitle, lang)}
    </p>

    <div class="mt-10">
      <Countdown lang={lang} />
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a
        href="#book"
        class="rounded-full bg-star px-7 py-3 text-base font-extrabold text-grape-900 shadow-[0_10px_30px_-8px_rgba(255,210,63,.6)] transition hover:brightness-105"
      >
        {t('cta.book')}
      </a>
      <a
        href={site.social.youtube}
        target="_blank"
        rel="noopener"
        class="rounded-full border border-white/25 px-7 py-3 text-base font-bold text-cream hover:bg-white/10"
      >
        YouTube ▶
      </a>
    </div>
  </div>
</section>
