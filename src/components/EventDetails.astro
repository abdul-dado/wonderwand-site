---
import { useTranslations, type Lang } from '@/i18n';
import { site, tx } from '@/data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const e = site.event;

const dateFmt = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-JO' : 'en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const timeFmt = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-JO' : 'en-GB', {
  hour: 'numeric',
  minute: '2-digit',
});
const start = new Date(e.startsAt);
const end = e.endsAt ? new Date(e.endsAt) : null;
const dateValue = dateFmt.format(start);
const timeValue = e.timeConfirmed
  ? end
    ? `${timeFmt.format(start)} – ${timeFmt.format(end)}`
    : timeFmt.format(start)
  : t('event.tbd');

const rows = [
  { label: t('event.when'), value: dateValue },
  { label: t('event.time'), value: timeValue },
  { label: t('event.where'), value: tx(e.venueName, lang) },
];
---

<section id="event" class="scroll-mt-24 bg-grape-50 py-16">
  <div class="mx-auto max-w-4xl px-4">
    <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">{tx(e.title, lang)}</h2>
    <p class="mt-2 text-ink/70">{tx(e.audience, lang)}</p>

    <dl class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        rows.map((r) => (
          <div class="rounded-2xl bg-white p-5 shadow-sm">
            <dt class="text-sm font-semibold text-grape-500">{r.label}</dt>
            <dd class="mt-1 font-display text-lg font-bold text-ink">{r.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-4 text-ink/80">{tx(e.address, lang)}</p>
    <p class="mt-1 text-sm font-semibold text-bubblegum">
      {tx(site.registration.capacityNote, lang)}
    </p>

    {
      e.googleMapsUrl && (
        <a
          href={e.googleMapsUrl}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-2 font-semibold text-grape-600 hover:text-grape-700"
        >
          📍 {t('event.map')}
        </a>
      )
    }
  </div>
</section>
