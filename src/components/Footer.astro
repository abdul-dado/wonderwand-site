---
import { useTranslations, type Lang } from '@/i18n';
import { site, type SiteContent } from '@/data/site';
import SocialLinks from './SocialLinks.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
  content?: SiteContent;
}
const { lang, content = site } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-grape-900 text-cream">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <Logo tone="cream" />
      <p class="mt-2 text-sm text-cream/60">
        © {year} {content.brandName}. {t('footer.rights')}.
      </p>
    </div>
    <div>
      <p class="mb-2 text-sm font-semibold text-cream/70">{t('footer.follow')}</p>
      <SocialLinks social={content.social} />
    </div>
  </div>
</footer>
