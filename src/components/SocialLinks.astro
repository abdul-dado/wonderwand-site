---
import { site, waHref, type SiteContent } from '@/data/site';

interface Props {
  class?: string;
  social?: SiteContent['social'];
}
const { class: className = '', social = site.social } = Astro.props;

const links = [
  { key: 'youtube', href: social.youtube, label: 'YouTube' },
  { key: 'instagram', href: social.instagram, label: 'Instagram' },
  { key: 'tiktok', href: social.tiktok, label: 'TikTok' },
  { key: 'facebook', href: social.facebook, label: 'Facebook' },
  { key: 'whatsapp', href: waHref(social.whatsapp), label: 'WhatsApp' },
  {
    key: 'email',
    href: social.email ? `mailto:${social.email}` : '',
    label: 'Email',
  },
].filter((l) => l.href);
---

<ul class:list={['flex flex-wrap items-center gap-2', className]}>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          target={l.key === 'email' ? undefined : '_blank'}
          rel="noopener"
          class="inline-flex items-center rounded-full border border-white/25 px-3 py-1.5 text-sm font-semibold text-cream/90 hover:bg-white/10"
        >
          {l.label}
        </a>
      </li>
    ))
  }
</ul>
