---
import { useTranslations, switchLangPath, otherLang, localizedPath, type Lang } from '@/i18n';
import Logo from './Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const langHref = switchLangPath(Astro.url, otherLang(lang));
const home = localizedPath(lang, '/');

const nav = [
  { href: '#about', label: t('nav.about') },
  { href: '#event', label: t('nav.event') },
  { href: '#activities', label: t('nav.activities') },
];
---

<header
  class="sticky top-0 z-40 border-b border-grape-100 bg-cream/90 backdrop-blur supports-[backdrop-filter]:bg-cream/75"
>
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
    <a href={home} aria-label="Wonder Wand" class="flex items-center">
      <Logo tone="ink" />
    </a>

    <nav class="mx-auto hidden gap-6 text-sm font-semibold text-ink/80 md:flex">
      {nav.map((item) => <a href={item.href} class="hover:text-grape-600">{item.label}</a>)}
    </nav>

    <div class="ms-auto flex items-center gap-2 md:ms-0">
      <a
        href={langHref}
        class="rounded-full border border-grape-200 px-3 py-1.5 text-sm font-semibold text-grape-700 hover:bg-grape-50"
        hreflang={otherLang(lang)}
      >
        {t('lang.switch')}
      </a>
      <a
        href="#book"
        class="rounded-full bg-grape-600 px-4 py-1.5 text-sm font-bold text-cream shadow-sm hover:bg-grape-700"
      >
        {t('cta.bookShort')}
      </a>
    </div>
  </div>
</header>
