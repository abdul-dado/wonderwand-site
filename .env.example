# Public site origin (used for canonical / hreflang / sitemap)
SITE_URL="https://wonderwand.org"

# --- Analytics (leave blank to disable) ---
PUBLIC_GA4_ID=""
PUBLIC_META_PIXEL_ID=""

# --- Turnstile (Cloudflare, spam protection on the booking form) ---
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Sanity CMS ---
# Create a free project at sanity.io, then:
PUBLIC_SANITY_PROJECT_ID="b9izpb2i"
PUBLIC_SANITY_DATASET="production"
SANITY_API_VERSION="2024-10-01"
# Editor/Deploy token with write access — used by /api/book to store bookings
SANITY_WRITE_TOKEN=""

# --- Email (Resend) ---
# Verify wonderwand.org as a sending domain in resend.com, then:
RESEND_API_KEY=""
# From must be on the verified domain (Gmail addresses can't be a sender).
BOOKING_FROM_EMAIL="info@wonderwand.org"
# Team inbox: new-booking alerts, paid-list copies, and the reply-to for parents.
BOOKING_NOTIFY_EMAIL="info@wonderwand.org"

# --- Webhook (Sanity -> site, fires the "paid" ticket email) ---
SANITY_WEBHOOK_SECRET=""

# --- Door check-in (/checkin) ---
CHECKIN_PIN=""
