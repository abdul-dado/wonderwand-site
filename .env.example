# Public site origin (used for canonical / hreflang / sitemap)
SITE_URL="https://wonderwand.org"

# --- Analytics (leave blank to disable) ---
PUBLIC_GA4_ID=""
PUBLIC_META_PIXEL_ID=""

# --- Turnstile (Cloudflare, spam protection on the booking form) ---
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Sanity CMS (added in phase 2) ---
PUBLIC_SANITY_PROJECT_ID=""
PUBLIC_SANITY_DATASET="production"
SANITY_API_VERSION="2024-10-01"
# Server-only write token used by the booking API to create booking documents
SANITY_WRITE_TOKEN=""

# --- Email (Resend, added in phase 3) ---
RESEND_API_KEY=""
BOOKING_FROM_EMAIL="events@wonderwand.org"
BOOKING_NOTIFY_EMAIL="events@wonderwand.org"
